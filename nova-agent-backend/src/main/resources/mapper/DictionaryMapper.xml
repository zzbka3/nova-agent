<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nova.agent.repository.DictionaryMapper">

    <resultMap id="BaseResultMap" type="com.nova.agent.model.po.Dictionary">
        <id column="id" property="id"/>
        <result column="code" property="code"/>
        <result column="value" property="value"/>
        <result column="description" property="description"/>
    </resultMap>

    <insert id="insert" parameterType="com.nova.agent.model.po.Dictionary">
        INSERT INTO dictionary (code, value, description) VALUES (#{code}, #{value}, #{description})
    </insert>

    <update id="updateById" parameterType="com.nova.agent.model.po.Dictionary">
        UPDATE dictionary SET value = #{value}, description = #{description} WHERE id = #{id}
    </update>

    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT * FROM dictionary WHERE code = #{code} LIMIT 1
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM dictionary ORDER BY id
    </select>

    <delete id="deleteById">
        DELETE FROM dictionary WHERE id = #{id}
    </delete>

</mapper>
