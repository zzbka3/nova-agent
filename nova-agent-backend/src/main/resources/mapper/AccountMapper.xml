<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nova.agent.repository.AccountMapper">

    <resultMap id="BaseResultMap" type="com.nova.agent.model.po.Account">
        <id column="account_id" property="accountId"/>
        <result column="account_name" property="accountName"/>
        <result column="status" property="status"/>
    </resultMap>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM account WHERE account_id = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM account ORDER BY account_id
    </select>

    <insert id="insert" parameterType="com.nova.agent.model.po.Account" useGeneratedKeys="true" keyProperty="accountId">
        INSERT INTO account (account_name, status) VALUES (#{accountName}, #{status})
    </insert>

    <delete id="deleteById">
        DELETE FROM account WHERE account_id = #{id}
    </delete>

</mapper>
