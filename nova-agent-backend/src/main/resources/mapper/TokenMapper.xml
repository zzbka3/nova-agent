<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nova.agent.repository.TokenMapper">

    <resultMap id="BaseResultMap" type="com.nova.agent.model.po.Token">
        <id column="id" property="id"/>
        <result column="token" property="token"/>
        <result column="account_id" property="accountId"/>
        <result column="permission" property="permission"/>
        <result column="expire_time" property="expireTime"/>
    </resultMap>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM token WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM token ORDER BY id
    </select>

    <insert id="insert" parameterType="com.nova.agent.model.po.Token" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO token (token, account_id, permission, expire_time)
        VALUES (#{token}, #{accountId}, #{permission}, #{expireTime})
    </insert>

    <delete id="deleteById">
        DELETE FROM token WHERE id = #{id}
    </delete>

</mapper>
