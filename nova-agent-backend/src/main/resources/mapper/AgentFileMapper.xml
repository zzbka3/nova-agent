<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nova.agent.repository.AgentFileMapper">

    <resultMap id="BaseResultMap" type="com.nova.agent.model.po.AgentFile">
        <id column="id" property="id"/>
        <result column="app_id" property="appId"/>
        <result column="conversation_id" property="conversationId"/>
        <result column="file_name" property="fileName"/>
        <result column="file_url" property="fileUrl"/>
        <result column="file_id" property="fileId"/>
    </resultMap>

    <insert id="insert" parameterType="com.nova.agent.model.po.AgentFile" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO agent_file (app_id, conversation_id, file_name, file_url, file_id, creator, create_time)
        VALUES (#{appId}, #{conversationId}, #{fileName}, #{fileUrl}, #{fileId}, #{creator}, #{createTime})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM agent_file WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM agent_file ORDER BY create_time DESC
    </select>

</mapper>
